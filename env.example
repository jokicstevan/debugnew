# PostgreSQL
PGHOST=localhost
PGDATABASE=grps
PGUSER=grps_user
PGPASSWORD=your_secure_password
PGPORT=5432
DATABASE_URL=postgresql://grps_user:your_secure_password@localhost:5432/grps

# Redis
REDIS_URL=redis://localhost:6379/0

# HERE Maps API (optional, falls back to OSRM)
HERE_API_KEY=your_here_api_key

# Flask
SECRET_KEY=your_random_secret_key_change_in_production
PORT=5000
